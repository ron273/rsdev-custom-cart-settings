#. Description of the plugin
#: rsdev-custom-cart-settings.php
msgid ""
"Enables shop owners to force orders in multiples of X (e.g. boxes containing "
"6 bottles of wine)."
msgstr ""

#. Author of the plugin
#: rsdev-custom-cart-settings.php
msgid "Ronald Smit"
msgstr ""

#. Author URI of the plugin
